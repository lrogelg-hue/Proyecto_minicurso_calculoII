@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada · Minicurso de Cálculo II</PageTitle>

<div class="no-encontrado">
    <p class="no-encontrado__codigo" aria-hidden="true">404</p>
    <h1>Esta sección no existe</h1>
    <p class="texto-tenue">
        El enlace al que llegó no corresponde a ninguna sección del minicurso. Use el menú para
        volver a una de las secciones disponibles.
    </p>
    <a class="btn btn-primary mt-2" href="">Volver a la carátula</a>
</div>
